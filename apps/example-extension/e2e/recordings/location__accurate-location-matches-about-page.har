content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/1152x720/bC6rL5WPFMB9Bony.mp4?tag=29\"},{\"bitrate\":10368000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/1280x800/1sunln4u7zCJOnSg.mp4?tag=29\"}]}}],\"urls\":[{\"display_url\":\"youtube.com/watch?v=xbixks…\",\"expanded_url\":\"https://www.youtube.com/watch?v=xbixkslEHqM\",\"indices\":[141,164],\"url\":\"https://t.co/TAwVltlTsF\"}]},\"extended_entities\":{\"media\":[{\"additional_media_info\":{\"monetizable\":false},\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/3djT3wgRKO\",\"expanded_url\":\"https://x.com/sotaproject/status/2113222744833765442/video/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"id_str\":\"2113222359033278464\",\"indices\":[276,299],\"media_key\":\"13_2113222359033278464\",\"media_results\":{\"result\":{\"media_key\":\"13_2113222359033278464\"}},\"media_url_https\":\"https://pbs.twimg.com/amplify_video_thumb/2113222359033278464/img/lzYDcaOkU00L-21W.jpg\",\"original_info\":{\"focus_rects\":[],\"height\":800,\"width\":1280},\"sizes\":{\"large\":{\"h\":800,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":750,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":425,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"video\",\"url\":\"https://t.co/3djT3wgRKO\",\"video_info\":{\"aspect_ratio\":[8,5],\"duration_millis\":135936,\"variants\":[{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/pl/Hj0_sA1lg-FbNCWi.m3u8?tag=29\"},{\"bitrate\":256000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/432x270/ZtZzCNaaZbX3nRzB.mp4?tag=29\"},{\"bitrate\":832000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/576x360/24iMekQQo4H2-2B2.mp4?tag=29\"},{\"bitrate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/1152x720/bC6rL5WPFMB9Bony.mp4?tag=29\"},{\"bitrate\":10368000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2113222359033278464/vid/avc1/1280x800/1sunln4u7zCJOnSg.mp4?tag=29\"}]}}]},\"favorite_count\":2,\"favorited\":false,\"full_text\":\"Ходорковский назвал правильным для политзаключенного умереть, если его освобождение будет означать чью-то смерть  \\n\\nМихаил Ходорковский дал (https://t.co/TAwVltlTsF) интервью Алексею Венедиктову на «Живом гвозде». Помимо прочего, он заявил, что освобождать политзаключенных в https://t.co/3djT3wgRKO\",\"id_str\":\"2113222744833765442\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"timestamps\":[],\"urls\":[{\"display_url\":\"youtube.com/watch?v=xbixks…\",\"expanded_url\":\"https://www.youtube.com/watch?v=xbixkslEHqM\",\"indices\":[141,164],\"url\":\"https://t.co/LLa3wKJTKQ\"}],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMyMjI3NDQ1OTQ2OTAwNDg=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":114}]},\"text\":\"Ходорковский назвал правильным для политзаключенного умереть, если его освобождение будет означать чью-то смерть  \\n\\nМихаил Ходорковский дал (https://t.co/LLa3wKJTKQ) интервью Алексею Венедиктову на «Живом гвозде». Помимо прочего, он заявил, что освобождать политзаключенных в обмен на возвращение роскоши путинскому окружению можно — но не если это будут уступки, позволяющие России убивать больше людей.\\n\\nВенедиктов предложил обсудить такие послабления, приведя в пример Беларусь, которая довольно часто отпускает своих политзаключенных в обмен на какие-то договоренности с США. Ходорковский ответил, что «вопрос в цене» — и этой ценой не могут быть украинцы: «Если за жизнь российского политического заключенного надо заплатить жизнью украинца, это не вариант для обмена».\\n\\nПо мнению Ходорковского, санкции в обмен на освобождение политзаключенных можно снимать с, к примеру, яхт приближенных Владимира Путина. \\n\\n«Если вместо 100 ракет они получают возможность выпускать 103 ракеты, а эти 103 ракеты у нас по статистике добавляют еще там пять жизней в минус. Ну, эти сидят — значит, пусть сидят. Если это политзаключенные. Я был готов умереть, и я считаю, что это правильно для политического заключенного умереть, если ему предлагают, чтобы он отдал чужую жизнь за свою», — сказал бизнесмен.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113222744833765442\",\"unmention_data\":{},\"views\":{\"count\":\"229\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113222744833765442\",\"sortIndex\":\"2113261255551614972\"},{\"content\":{\"__typename\":\"TimelineTimelineModule\",\"clientEventInfo\":{\"component\":\"suggest_who_to_follow\",\"details\":{\"timelinesDetails\":{\"controllerData\":\"DAACDAACDAABCgABAAAAAAAAAAgAAAAA\",\"injectionType\":\"WhoToFollow\",\"sourceData\":\"DAABCgABczsSb+pzFzwKAAIAAAAAAAAAAAAIAAIAAACDCAADAAAAAgwABQwAAgwAAgwAAQoAAQAAAAAAAAAIAAAAAAA=\"}}},\"displayType\":\"Vertical\",\"entryType\":\"TimelineTimelineModule\",\"footer\":{\"displayType\":\"Classic\",\"landingUrl\":{\"url\":\"twitter://connect_people?user_id=1542541675842732032\\u0026display_location=profile_wtf_showmore\",\"urlType\":\"DeepLink\"},\"text\":\"Show more\"},\"header\":{\"displayType\":\"Classic\",\"sticky\":false,\"text\":\"Who to follow\"},\"items\":[{\"entryId\":\"who-to-follow-2113261255551614981-user-1638108173486764033\",\"item\":{\"clientEventInfo\":{\"component\":\"suggest_who_to_follow\",\"details\":{\"timelinesDet