h\":1280},\"sizes\":{\"large\":{\"h\":853,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":800,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/pBiMZVyNiu\"}]},\"favorite_count\":2,\"favorited\":false,\"full_text\":\"Российские войска обстреляли рынок в Харьковской области: двое погибших и 34 раненых\\n\\nВ результате российского удара по рынку в городе Лозовая погибли женщины в возрасте 50 и 60 лет, ещё 34 человека получили ранения различной степени тяжести. Об этом сообщил глава Харьковской https://t.co/pBiMZVyNiu\",\"id_str\":\"2113250617024033046\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMyNTA2MTY5NDAxNDI1OTI=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":84}]},\"text\":\"Российские войска обстреляли рынок в Харьковской области: двое погибших и 34 раненых\\n\\nВ результате российского удара по рынку в городе Лозовая погибли женщины в возрасте 50 и 60 лет, ещё 34 человека получили ранения различной степени тяжести. Об этом сообщил глава Харьковской областной военной администрации Олег Синегубов.\\n\\nНа месте обстрела работают спасатели, медики и полиция. Пострадавшим оказывают медицинскую помощь, спасательные работы продолжаются.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113250617024033046\",\"unmention_data\":{},\"views\":{\"count\":\"77\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113250617024033046\",\"sortIndex\":\"2113261255551614976\"},{\"conten