ct/status/2113171106102452654/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2113171099370262528\",\"indices\":[113,136],\"media_key\":\"3_2113171099370262528\",\"media_results\":{\"result\":{\"media_key\":\"3_2113171099370262528\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVN96zeWEAAgsxR.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":387,\"w\":691,\"x\":0,\"y\":0},{\"h\":387,\"w\":387,\"x\":0,\"y\":0},{\"h\":387,\"w\":339,\"x\":0,\"y\":0},{\"h\":387,\"w\":194,\"x\":33,\"y\":0},{\"h\":387,\"w\":748,\"x\":0,\"y\":0}],\"height\":387,\"width\":748},\"sizes\":{\"large\":{\"h\":387,\"resize\":\"fit\",\"w\":748},\"medium\":{\"h\":387,\"resize\":\"fit\",\"w\":748},\"small\":{\"h\":352,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/bemSgHGe3D\"}]},\"favorite_count\":5,\"favorited\":false,\"full_text\":\"Путин наградил телеведущих Екатерину Андрееву и Елену Малышеву орденом «За заслуги перед отечеством» IV степени. https://t.co/bemSgHGe3D\",\"id_str\":\"2113171106102452654\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":1,\"reply_count\":2,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113171106102452654\",\"unmention_data\":{},\"views\":{\"count\":\"291\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113171106102452654\",\"sortIndex\":\"2113261255551614966\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"twe