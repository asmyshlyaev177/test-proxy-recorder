\"faces\":[]}},\"id_str\":\"2113200591547559937\",\"indices\":[281,304],\"media_key\":\"3_2113200591547559937\",\"media_results\":{\"result\":{\"media_key\":\"3_2113200591547559937\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOYveZWcAEM8p7.png\",\"original_info\":{\"focus_rects\":[{\"h\":474,\"w\":846,\"x\":0,\"y\":30},{\"h\":504,\"w\":504,\"x\":191,\"y\":0},{\"h\":504,\"w\":442,\"x\":222,\"y\":0},{\"h\":504,\"w\":252,\"x\":317,\"y\":0},{\"h\":504,\"w\":846,\"x\":0,\"y\":0}],\"height\":504,\"width\":846},\"sizes\":{\"large\":{\"h\":504,\"resize\":\"fit\",\"w\":846},\"medium\":{\"h\":504,\"resize\":\"fit\",\"w\":846},\"small\":{\"h\":405,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/TQkrYRwwCO\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/TQkrYRwwCO\",\"expanded_url\":\"https://x.com/sotaproject/status/2113200600263377141/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2113200591547559937\",\"indices\":[281,304],\"media_key\":\"3_2113200591547559937\",\"media_results\":{\"result\":{\"media_key\":\"3_2113200591547559937\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOYveZWcAEM8p7.png\",\"original_info\":{\"focus_rects\":[{\"h\":474,\"w\":846,\"x\":0,\"y\":30},{\"h\":504,\"w\":504,\"x\":191,\"y\":0},{\"h\":504,\"w\":442,\"x\":222,\"y\":0},{\"h\":504,\"w\":252,\"x\":317,\"y\":0},{\"h\":504,\"w\":846,\"x\":0,\"y\":0}],\"height\":504,\"width\":846},\"sizes\":{\"large\":{\"h\":504,\"resize\":\"fit\",\"w\":846},\"medium\":{\"h\":504,\"resize\":\"fit\",\"w\":846},\"small\":{\"h\":405,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/TQkrYRwwCO\"}]},\"favorite_count\":3,\"favorited\":false,\"full_text\":\"Объявленного участником «Соты» амурского журналиста Андрея Афанасьева оштрафовали за отсутствие в «Соте» «иноагентских» плашек.\\n\\nОтсутствие плашек Архаринский районный суд Амурской области посчитал «общественно опасным правонарушением против порядка управления» и вынес штраф в 30 https://t.co/TQkrYRwwCO\",\"id_str\":\"2113200600263377141\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMyMDA2MDAxNTg0NTM3NjA=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Объявленного участником «Соты» амурского журналиста Андрея Афанасьева оштрафовали за отсутствие в «Соте» «иноагентских» плашек.\\n\\nОтсутствие плашек Архаринский районный суд Амурской области посчитал «общественно опасным правонарушением против порядка управления» и вынес штраф в 30 тысяч рублей.\\n\\nПри этом Андрей Афанасьев не является членом редакции «Соты» и не может влиять на ее редакционную политику. Сейчас он живет в Германии.\\n\\nИнтересно, что в конце сентября в Архангельске также за отсутствие «иноагентских» плашек в «Соте» была оштрафована на 40 тысяч рублей бывшая редактор «Соты» Дарья Порядина, перешедшая в «Верстку» 2 года назад. Суд отказался учитывать справку из литовского юрлица «Соты» о завершении работы Дарьи в редакции.\\n\\nНа этом фоне сумма штрафов редактора «Соты» Алексея Обухова за игнорирование «Сотой» «иноагентства» уже превысили полмиллиона рублей.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113200600263377141\",\"unmention_data\":{},\"views\":{\"count\":\"187\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113200600263377141\",\"sortIndex\":\"2113261255551614969\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://pbs.twimg.com/profile_images/1731639227706740736/bLj-yFAC_normal.jpg\"},\"banner\":{\"image_url\":\"https://pbs.twimg.com/profile_banners/1542541675842732032/1656657572\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media \\u0026 News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8466,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":true,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19953,\"tweets\":30989},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2113196400632561850\"],\"editable_until_msecs\":\"1792663857000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2113196400632561850\",\"created_at\":\"Thu Oct 22 09:10:57 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/3jZuk8RzX9\",\"expanded_url\":\"https://x.com/sotaproject/status/2113196400632561850/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2113196314175442944\",\"indices\":[278,301],\"media_key\":\"3_2113196314175442944\",\"media_results\":{\"result\":{\"media_key\":\"3_2113196314175442944\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOU2f8XkAAsvwh.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":617,\