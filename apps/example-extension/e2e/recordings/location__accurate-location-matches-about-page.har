y\":0},{\"h\":853,\"w\":748,\"x\":0,\"y\":0},{\"h\":853,\"w\":427,\"x\":0,\"y\":0},{\"h\":853,\"w\":1280,\"x\":0,\"y\":0}],\"height\":853,\"width\":1280},\"sizes\":{\"large\":{\"h\":853,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":800,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/plLAI0wCQm\"}]},\"favorite_count\":4,\"favorited\":false,\"full_text\":\"Россия атаковала Харьков и область: погибла женщина, пострадали 15 человек, среди них трое детей\\n\\nОб этом сообщил глава областной военной администрации Олег Синегубов.\\n\\nВ селе Лимановка погибла 42-летняя женщина, а 13-летний мальчик получил ранения. Ещё восемь человек, включая https://t.co/plLAI0wCQm\",\"id_str\":\"2113168993313849723\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMxNjg5OTMyMjU3ODEyNDg=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":96}]},\"text\":\"Россия атаковала Харьков и область: погибла женщина, пострадали 15 человек, среди них трое детей\\n\\nОб этом сообщил глава областной военной администрации Олег Синегубов.\\n\\nВ селе Лимановка погибла 42-летняя женщина, а 13-летний мальчик получил ранения. Ещё восемь человек, включая ребёнка, испытали острую реакцию на стресс. Пострадавшие также есть в Дергачах, Изюме и других населённых пунктах области, среди раненых — пятилетняя девочка.\\n\\nВ Харькове после российских ударов повреждены жилые дома, магазин, автомобили и электросети. В других районах области также пострадали частные дома и гражданская инфраструктура.\\n\\nСинегубов сообщил о новом ударе по Основянскому району Харькова, последствия которого еще выясняются.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113168993313849723\",\"unmention_data\":{},\"views\":{\"count\":\"220\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113168993313849723\",\"sortIndex\":\"2113261255551614965\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://pbs.twimg.com/profile_images/1731639227706740736/bLj-yFAC_normal.jpg\"},\"banner\":{\"image_url\":\"https://pbs.twimg.com/profile_banners/1542541675842732032/1656657572\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media \\u0026 News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https