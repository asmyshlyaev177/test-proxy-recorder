g\":true,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19953,\"tweets\":30989},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2113209297538539558\"],\"editable_until_msecs\":\"1792666932000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2113209297538539558\",\"created_at\":\"Thu Oct 22 10:02:12 +0000 2026\",\"display_text_range\":[0,276],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/nrwUttVc8Z\",\"expanded_url\":\"https://x.com/sotaproject/status/2113209297538539558/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"medium\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"orig\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"small\":{\"faces\":[{\"h\":56,\"w\":56,\"x\":7,\"y\":129}]}},\"id_str\":\"2113209290987024384\",\"indices\":[277,300],\"media_key\":\"3_2113209290987024384\",\"media_results\":{\"result\":{\"media_key\":\"3_2113209290987024384\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOgp2VWMAAhhd4.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":323,\"w\":576,\"x\":0,\"y\":244},{\"h\":576,\"w\":576,\"x\":0,\"y\":117},{\"h\":657,\"w\":576,\"x\":0,\"y\":77},{\"h\":1082,\"w\":541,\"x\":0,\"y\":0},{\"h\":1082,\"w\":576,\"x\":0,\"y\":0}],\"height\":1082,\"width\":576},\"sizes\":{\"large\":{\"h\":1082,\"resize\":\"fit\",\"w\":576},\"medium\":{\"h\":1082,\"resize\":\"fit\",\"w\":576},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":362},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/nrwUttVc8Z\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/nrwUttVc8Z\",\"expanded_url\":\"https://x.com/sotaproject/status/2113209297538539558/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"medium\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"orig\":{\"faces\":[{\"h\":90,\"w\":90,\"x\":12,\"y\":206}]},\"small\":{\"faces\":[{\"h\":56,\"w\":56,\"x\":7,\"y\":129}]}},\"id_str\":\"2113209290987024384\",\"indices\":[277,300],\"media_key\":\"3_2113209290987024384\",\"media_results\":{\"result\":{\"media_key\":\"3_2113209290987024384\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOgp2VWMAAhhd4.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":323,\"w\":576,\"x\":0,\"y\":244},{\"h\":576,\"w\":576,\"x\":0,\"y\":117},{\"h\":657,\"w\":576,\"x\":0,\"y\":77},{\"h\":1082,\"w\":541,\"x\":0,\"y\":0},{\"h\":1082,\"w\":576,\"x\":0,\"y\":0}],\"height\":1082,\"width\":576},\"sizes\":{\"large\":{\"h\":1082,\"resize\":\"fit\",\"w\":576},\"medium\":{\"h\":1082,\"resize\":\"fit\",\"w\":576},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":362},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/nrwUttVc8Z\"}]},\"favorite_count\":3,\"favorited\":false,\"full_text\":\"Оппозиционного белорусского блогера Виталия Кондратенко не пустили на украинскую конференцию из-за присутствия там сотрудницы Тихановской.\\n\\nСегодня в украинском Ужгороде началась конференция «Вместе для лучшего будущего: хорошие практики, сотрудничество и сильные сообщества в https://t.co/nrwUttVc8Z\",\"id_str\":\"2113209297538539558\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":1,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMyMDkyOTczMzcyNDk3OTI=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Оппозиционного белорусского блогера Виталия Кондратенко не пустили на украинскую конференцию из-за присутствия там сотрудницы Тихановской.\\n\\nСегодня в украинском Ужгороде началась конференция «Вместе для лучшего будущего: хорошие практики, сотрудничество и сильные сообщества в европейской Украине». Согласно анонсу, мероприятие объединило «лидеров национальных меньшинств и этнических общин, представителей общественных организаций, научных работников, экспертов, дипломатов и представителей государственной власти» с целью «создать пространство, в котором можно познакомиться, показать свои успешные проекты, обменяться опытом, обсудить общие вызовы и найти партнеров для новых инициатив».\\n\\nИзвестный белорусский блогер Виталий «Вирус» Кондратенко, получивший от украинских властей статус политбеженца, был приглашен на мероприятие, однако в последний момент перед его началом приглашение было отозвано «по соображениям безопасности».\\n\\nПо мнению Кондратенко, это произошло из-за участия в конференции украинской представительницы Офиса Светланы Тихановской Ольги Зазулинской. Кондратенко является активным критиком Тихановской и писал о предшественнице Зазулинской Светлане Шатилиной, сын которой – депутат горсовета Ирпеня Никита Шатилин – был обвинен в организации схемы по переправке военнообязанных за границу. Муж Шатилиной, Андрей Шатилин, ранее был осужден за передачу взяток мэру Гостомеля.\\n\\nС Кондратенко увидевшая его на улице Зазулинская разговаривать сегодня отказалась.\\n\\nПри этом блогер является волонтером ВСУ и на днях – не в первый раз – передал украинской армии личную машину.\\n\\nСкриншот переписки с организаторами конференции: Виталий Кондратенко\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113209297538539558\",\"unmention_data\":{},\"views\":{\"count\":\"271\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113209297538539558\",\"sortIndex\":\"2113261255551614970\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://pbs.twimg.com/profile_images/1731639227706740736/bLj-yFAC_normal.jpg\"},\"banner\":{\"image_url\":\"https://pbs.twimg.com/profile_banners/1542541675842732032/1656657572\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media \\u0026 News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\