w\":1238,\"x\":0,\"y\":0},{\"h\":828,\"w\":828,\"x\":0,\"y\":0},{\"h\":828,\"w\":726,\"x\":0,\"y\":0},{\"h\":828,\"w\":414,\"x\":0,\"y\":0},{\"h\":828,\"w\":1238,\"x\":0,\"y\":0}],\"height\":828,\"width\":1238},\"sizes\":{\"large\":{\"h\":828,\"resize\":\"fit\",\"w\":1238},\"medium\":{\"h\":803,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":455,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/3jZuk8RzX9\"},{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/3jZuk8RzX9\",\"expanded_url\":\"https://x.com/sotaproject/status/2113196400632561850/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":45,\"w\":45,\"x\":697,\"y\":218},{\"h\":45,\"w\":45,\"x\":852,\"y\":243}]},\"medium\":{\"faces\":[{\"h\":42,\"w\":42,\"x\":653,\"y\":204},{\"h\":42,\"w\":42,\"x\":798,\"y\":227}]},\"orig\":{\"faces\":[{\"h\":45,\"w\":45,\"x\":697,\"y\":218},{\"h\":45,\"w\":45,\"x\":852,\"y\":243}]},\"small\":{\"faces\":[{\"h\":23,\"w\":23,\"x\":370,\"y\":115},{\"h\":23,\"w\":23,\"x\":452,\"y\":129}]}},\"id_str\":\"2113196352880390144\",\"indices\":[278,301],\"media_key\":\"3_2113196352880390144\",\"media_results\":{\"result\":{\"media_key\":\"3_2113196352880390144\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOU4wIWMAA068E.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":655,\"w\":1170,\"x\":110,\"y\":0},{\"h\":655,\"w\":655,\"x\":471,\"y\":0},{\"h\":655,\"w\":575,\"x\":511,\"y\":0},{\"h\":655,\"w\":328,\"x\":634,\"y\":0},{\"h\":655,\"w\":1280,\"x\":0,\"y\":0}],\"height\":655,\"width\":1280},\"sizes\":{\"large\":{\"h\":655,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":614,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":348,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/3jZuk8RzX9\"},{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/3jZuk8RzX9\",\"expanded_url\":\"https://x.com/sotaproject/status/2113196400632561850/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2113196381233901569\",\"indices\":[278,301],\"media_key\":\"3_2113196381233901569\",\"media_results\":{\"result\":{\"media_key\":\"3_2113196381233901569\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HVOU6ZwWcAEwadS.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":641,\"w\":1145,\"x\":100,\"y\":0},{\"h\":641,\"w\":641,\"x\":352,\"y\":0},{\"h\":641,\"w\":562,\"x\":391,\"y\":0},{\"h\":641,\"w\":321,\"x\":512,\"y\":0},{\"h\":641,\"w\":1280,\"x\":0,\"y\":0}],\"height\":641,\"width\":1280},\"sizes\":{\"large\":{\"h\":641,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":601,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":341,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/3jZuk8RzX9\"}]},\"favorite_count\":9,\"favorited\":false,\"full_text\":\"Минюст назвал критику своего созданного с помощью ИИ проекта об иноагентах «личной обидой»\\n\\nВ июле Минюст запустил онлайн-версию выставки «Защита суверенитета Российского государства. История и современность», посвященной рассказу о противодействии России иностранному влиянию. https://t.co/3jZuk8RzX9\",\"id_str\":\"2113196400632561850\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[{\"display_url\":\"t.me/sotaproject/11…\",\"expanded_url\":\"https://t.me/sotaproject/116520\",\"indices\":[986,1009],\"url\":\"https://t.co/yNw6ZvMLB7\"},{\"display_url\":\"tass.ru/politika/28240…\",\"expanded_url\":\"https://tass.ru/politika/28240949\",\"indices\":[1371,1394],\"url\":\"https://t.co/lgyWadYYGj\"}],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMxOTY0MDA0MTg2ODkwMjQ=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":90}]},\"text\":\"Минюст назвал критику своего созданного с помощью ИИ проекта об иноагентах «личной обидой»\\n\\nВ июле Минюст запустил онлайн-версию выставки «Защита суверенитета Российского государства. История и современность», посвященной рассказу о противодействии России иностранному влиянию. Понять логику авторов невозможно: все тексты сайта были либо написаны не владеющим русским языком человеком, либо сгенерированы вместе с сайтом без какой-либо проверки (см. скриншоты). \\n\\nТакже на сайт скопирован реестр иноагентов, в описании которых также присутствуют ошибки. Например, читателям рассказывают о «предварительной военной операции», «Форуме свободных Государственной Почты России» (должна быть Пост-Россия) и т.д. На данный момент часть ошибок уже исправлена. \\n\\nЖурналистка Екатерина Клепиковская тогда обнаружила в своей карточке фотографию другой женщины — Анны Клепиковской, занимающейся продвижением культурно-ландшафтного парка «Голубино». Другая журналистка, Светлана Прокопьева, нашла (https://t.co/yNw6ZvMLB7) в галерее две карточки несуществующего иноагента «Сергея Сидорова» — без фотографий и биографий. На одной стоял номер 12, на другой номера не было. Прокопьева предположила, что разработчики проверяли на вымышленном персонаже шаблоны страниц, а затем забыли удалить тестовые записи с опубликованного сайта.\\n\\nСегодня амминистра юстиции Олег Свириденко заверил  (https://t.co/lgyWadYYGj)ТАСС, что каждый факт выставки сверяли с архивными первоисточниками, а материалы готовили историки и представители музеев. \\n\\nКритиков он обвинил в подмене фактов трактовками, выгодными западным «работодателям», и использовании голословных эмоциональных заявлений вместо фактов. По словам Свириденко, иностранные агенты, увидев материал об иностранном влиянии, были не просто заинтересованы, но ли «лично обижены»: «Как говорится, на воре и шапка горит, они увидели себя в исторических материалах».\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113196400632561850\",\"unmention_data\":{},\"views\":{\"count\":\"442\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113196400632561850\",\"sortIndex\":\"2113261255551614968\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://pbs.twimg.com/profile_images/1731639227706740736/bLj-yFAC_normal.jpg\"},\"banner\":{\"image_url\":\"https://pbs.twimg.com/profile_banners/1542541675842732032/1656657572\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media \\u0026 News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8466,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":true,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19953,\"tweets\":30989},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2113173075466309700\"],\"editable_until_msecs\":\"1792658296000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":1,\"bookmarked\":false,\"conversation_id_str\":\"2113173075466309700\",\"created_at\":\"Thu Oct 22 07:38:16 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{},\"favorite_count\":5,\"favorited\":false,\"full_text\":\"Бывшего оператора ФБК Павла Зеленского исключили из списка экстремистов Росфинмониторинга.\\n\\nВ апреле 2021 Зеленского приговорили к двум годам колонии по ч.2 ст.280 УК (публичные призывы к экстремизму в интернете) за «экстремистские» твиты, вызванные возмущением от гибели Ирины\",\"id_str\":\"2113173075466309700\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":1,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMTMxNzMwNzUzOTUwMDIzNjg=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Бывшего оператора ФБК Павла Зеленского исключили из списка экстремистов Росфинмониторинга.\\n\\nВ апреле 2021 Зеленского приговорили к двум годам колонии по ч.2 ст.280 УК (публичные призывы к экстремизму в интернете) за «экстремистские» твиты, вызванные возмущением от гибели Ирины Славиной.\\n\\nУже в 2024 году Зеленского задержали в день похорон Алексея Навального и осудили на 15 суток под предлогом мелкого хулиганства.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleTweet\"},\"rest_id\":\"2113173075466309700\",\"unmention_data\":{},\"views\":{\"count\":\"749\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2113173075466309700\",\"sortIndex\":\"2113261255551614967\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://pbs.twimg.com/profile_images/1731639227706740736/bLj-yFAC_normal.jpg\"},\"banner\":{