# Test-only env for the example app. Committed so a fresh clone can run the
# replay suite with no setup. In a real app this file would NOT be committed;
# production sets REVALIDATE_SECRET in the deployment environment (see .env.example).
REVALIDATE_SECRET=test-revalidate-secret

# The authenticated dashboard's AWS Cognito config (VITE_COGNITO_REGION,
# VITE_COGNITO_CLIENT_ID) and the secret test-user credentials are deliberately
# NOT committed — they'd tie this demo to a real Cognito pool. They live in
# .env.local (gitignored) or CI secrets; see .env.example. Without them the Cognito
# auth suite is skipped and every other spec still records/replays.
