# Proxy / API configuration
#
# NOTE: Set these to the proxy address in dev/test so all requests (browser + SSR)
# are recorded/replayed. In production, point them directly at the real backend.
#
# VITE_API_URL is baked in at build time (exposed to the browser).
# BACKEND_URL is server-side only (used by the SSR server functions).

# Dev / test — route everything through the proxy
VITE_API_URL=http://localhost:8100
BACKEND_URL=http://localhost:8100

# Production — uncomment and set the real backend URL
# VITE_API_URL=http://localhost:3002
# BACKEND_URL=http://localhost:3002

# Mock backend port (used by mock-backend/server.mjs)
MOCK_BACKEND_PORT=3002

# Secret required by the /api/revalidate endpoint (src/routes/api/revalidate.ts).
# In production set this to a strong shared secret and have your CMS webhook send
# it in the x-revalidate-token header. The example app's committed .env sets a
# known test value so the replay suite runs on a fresh clone.
REVALIDATE_SECRET=test-revalidate-secret
