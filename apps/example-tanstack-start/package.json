{
  "name": "example-tanstack-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "mock": "MOCK_BACKEND_PORT=3002 node mock-backend/server.mjs",
    "proxy": "test-proxy-recorder",
    "proxy:reset": "test-proxy-recorder reset",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:test": "TEST_PROXY_RECORDER_ENABLED=true vite build",
    "start": "TEST_PROXY_RECORDER_ENABLED=true PORT=3000 node --env-file-if-exists=.env .output/server/index.mjs",
    "start:all": "concurrently \"pnpm mock\" \"pnpm proxy\" \"pnpm start\"",
    "test:e2e": "pnpm build:test && concurrently --kill-others --success first --names services,tests \"pnpm start:all\" \"wait-on http://127.0.0.1:3000 http://127.0.0.1:8100/__control && APP_PORT=3000 playwright test --retries 1 && node e2e/assert-redactions.mjs\"",
    "test:e2e:ci": "pnpm build:test && concurrently --kill-others --success first --names services,tests \"pnpm start:all\" \"wait-on http://127.0.0.1:3000 http://127.0.0.1:8100/__control --timeout 120000 && APP_PORT=3000 RECORD_MODE=1 playwright test --workers 1 && node e2e/assert-redactions.mjs && APP_PORT=3000 playwright test --retries 1\"",
    "test:e2e:ui": "APP_PORT=3000 playwright test --ui --retries 1",
    "test:e2e:record": "APP_PORT=3000 RECORD_MODE=1 playwright test --workers 1 --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.0",
    "nitro": "^3.0.260311-beta",
    "test-proxy-recorder": "workspace:*",
    "typescript": "^5.6.0",
    "vite": "^8.0.14",
    "wait-on": "^8.0.0",
    "ws": "^8.18.3"
  }
}
