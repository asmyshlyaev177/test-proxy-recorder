---
// Code snippets render through markdown partials (src/snippets/*.md) rather
// than astro:components' <Code>. Starlight disables Astro's built-in Shiki in
// favour of Expressive Code; EC highlights markdown at build time in Node, so
// these blocks prerender to static HTML and work under the Cloudflare workerd
// prerender (where a render-time highlighter does not).
import { Content as AiPromptSnippet } from '../snippets/ai-prompt.md';
import { Content as InstallSnippet } from '../snippets/install.md';
import { Content as ApiEnvSnippet } from '../snippets/api-env.md';
import { Content as FixtureSnippet } from '../snippets/fixture.md';
import { Content as AuthSetupSnippet } from '../snippets/auth-setup.md';
import { Content as RecordingSnippet } from '../snippets/recording.md';
import aiPromptSource from '../snippets/ai-prompt.md?raw';
import CopyButton from './CopyButton.astro';
import Layout from '../layouts/Layout.astro';
import RecorderScene from './RecorderScene.astro';
import type { HomeCopy } from '../i18n/home/types';
import type { Locale } from '../../../../scripts/i18n/locales.mjs';
import { localePrefix } from '../i18n';
import { version } from '../../../test-proxy-recorder/package.json';

// One implementation of the marketing page, rendered by both routes: the
// unprefixed English `/`, which stays server-rendered so middleware can
// negotiate Markdown for agents, and the prerendered `/<locale>/` pages.
// Structure, URLs, the install command and the comparison data live here; the
// words arrive as `copy`, one module per language.
interface Props {
  copy: HomeCopy;
  locale: Locale;
}

const { copy: home, locale } = Astro.props;
const aiPrompt = aiPromptSource.replace(/^```[^\n]*\n/, '').replace(/\n```\s*$/, '');
const sample = home.recordingSample;
const questions = home.replayQuestions;

const repo = 'https://github.com/asmyshlyaev177/test-proxy-recorder';
const docsBase = `${localePrefix(locale.code)}/docs/`;

const installCmd = 'npm i -D test-proxy-recorder';

// Comparison table. y = yes, n = no, p = partial (see footnote).
// The feature labels down the left are copy, so they live in the copy module
// (`home.compare.features`) and line up with each row's `cells` by index.
const compareRows: {
  tool: string;
  self?: boolean;
  note?: string;
  cells: ('y' | 'n' | 'p')[];
}[] = [
  { tool: 'test-proxy-recorder', self: true, cells: ['y', 'y', 'y', 'y', 'y', 'y'] },
  { tool: 'Playwright routeFromHAR', cells: ['y', 'n', 'y', 'n', 'y', 'y'] },
  // Playwright-native through the official @msw/playwright binding (browser requests).
  { tool: 'MSW', cells: ['n', 'y', 'y', 'y', 'y', 'y'] },
  { tool: 'Polly.js', cells: ['y', 'p', 'y', 'n', 'n', 'n'] },
  { tool: 'playwright-network-cache', cells: ['y', 'n', 'y', 'n', 'y', 'y'] },
  { tool: 'Mocky Balboa', cells: ['n', 'y', 'y', 'n', 'y', 'y'] },
];
const markGlyph = { y: '✓', n: '✕', p: '~' } as const;
const markText = home.compare.markText;
---

<Layout locale={locale} copy={home}>
  <!-- ============================================================ hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">{home.hero.title}</h1>
        <p class="hero-headline">{home.hero.headlineTop}<br />{home.hero.headlineBottom}</p>
        <p class="hero-sub">
          {home.hero.sub}
        </p>
        <div class="hero-actions">
          <span class="cmd">
            <code>{installCmd}</code>
            <CopyButton text={installCmd} label={home.hero.copyLabel} copiedLabel={home.chrome.copied} />
          </span>
          <a class="btn btn-ghost btn-star" href={`${repo}/stargazers`}>
            <span class="star-glyph" aria-hidden="true">★</span> {home.hero.starCta}
            {/* width/height reserve the box before the badge arrives — it is
                a third-party image in the hero, so without them it lands at
                0px wide and shifts the row. Not `loading="lazy"`: above the
                fold that only delays the request, and the shift with it. */}
            <img
              class="star-count"
              src="https://img.shields.io/github/stars/asmyshlyaev177/test-proxy-recorder?style=flat&label=&color=%231e40af"
              alt=""
              width="31"
              height="20"
            />
          </a>
        </div>
        <p class="hero-fine">
          v{version} · {home.hero.fine}
        </p>
      </div>
      <RecorderScene pauseLabel={home.hero.scenePause} playLabel={home.hero.scenePlay} />
    </div>
  </section>

  <!-- ============================================================ demo -->
  <section class="band demo" id="demo">
    <div class="container demo-inner">
      <h2>{home.demo.heading}</h2>
      <p class="section-sub">
        {home.demo.sub}
      </p>
      <figure class="demo-frame">
        <video
          class="demo-video"
          muted
          loop
          playsinline
          preload="none"
          controls
          poster="/demo-poster.webp"
          aria-label={home.demo.videoLabel}
        >
          <source src="/demo.webm" type="video/webm" />
          <source src="/demo.mp4" type="video/mp4" />
        </video>
      </figure>
    </div>
  </section>

  <!-- ======================================================= mechanisms -->
  <section class="mechanisms">
    <div class="container">
      <h2>{home.mechanisms.heading}</h2>
      <p class="section-sub">
        {home.mechanisms.sub}
      </p>
      <div class="mech-grid">
        <article class="mech">
          <header class="mech-head">
            <h3>{home.mechanisms.proxy.title}</h3>
            <code class="mech-ext">.mock.json</code>
          </header>
          <p class="mech-flow">{home.mechanisms.proxy.flow}</p>
          <p class="mech-when">{home.mechanisms.proxy.when}</p>
          <p>
            {home.mechanisms.proxy.body}
          </p>
          <p>{home.mechanisms.proxy.parallel}</p>
          <p class="mech-links">
            <a class="mech-guide" href={`${docsBase}integrations/nextjs/`}>
              {home.mechanisms.proxy.guideNextjs}
            </a>{' '}
            <a class="mech-guide" href={`${docsBase}integrations/tanstack-start/`}>
              {home.mechanisms.proxy.guideTanstack}
            </a>
          </p>
          <p class="mech-links">
            <a class="mech-example" href={`${repo}/tree/master/apps/example-nextjs16`}>
              {home.mechanisms.proxy.exampleNextjs}
            </a>{' '}
            <a class="mech-example" href={`${repo}/tree/master/apps/example-tanstack-start`}>
              {home.mechanisms.proxy.exampleTanstack}
            </a>
          </p>
        </article>
        <article class="mech">
          <header class="mech-head">
            <h3>{home.mechanisms.har.title}</h3>
            <code class="mech-ext">.har</code>
          </header>
          <p class="mech-flow">{home.mechanisms.har.flow}</p>
          <p class="mech-when">{home.mechanisms.har.when}</p>
          <p>
            {home.mechanisms.har.bodyStart} <code>fetch</code>{' '}
            {home.mechanisms.har.bodyEnd}
          </p>
          <p>{home.mechanisms.har.proxyNote}</p>
          <p class="mech-links">
            <a class="mech-guide" href={`${docsBase}integrations/playwright/`}>
              {home.mechanisms.har.guidePlaywright}
            </a>
          </p>
          <p class="mech-links">
            <a class="mech-example" href={`${repo}/tree/master/apps/example-websocket`}>
              {home.mechanisms.har.exampleVite}
            </a>{' '}
            <a class="mech-example" href={`${repo}/tree/master/apps/example-extension`}>
              {home.mechanisms.har.exampleExtension}
            </a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ================================================ recording sample -->
  {/* Right after the cards that introduce .mock.json, so the real file shows
      where the page first names it. Only the facts the file itself shows sit
      beside it: the edge cases, read here, came before any reason to try the
      tool (2026-10-03 critique), so they wait until after Quick start. */}
  <section class="band recording" id="recording">
    <div class="container">
      <h2>{sample.heading}</h2>
      <div class="recording-grid">
        <dl class="facts">
          <div>
            <dt>{sample.perTest.term}</dt>
            <dd>
              {sample.perTest.start} <code>npx playwright test -g "adds a todo"</code>{' '}
              {sample.perTest.end}
            </dd>
          </div>
          <div>
            <dt>{sample.testId.term}</dt>
            <dd>
              {sample.testId.start} <code>x-test-rcrd-id</code> {sample.testId.mid}{' '}
              <code>registerProxyFetch()</code> {sample.testId.end}
            </dd>
          </div>
          <div>
            <dt>{sample.secrets.term}</dt>
            <dd>
              {sample.secrets.body}{' '}
              <a href={`${docsBase}guides/secret-redaction/`}>{sample.secrets.link}</a>
            </dd>
          </div>
        </dl>
        <figure class="sample" id="recording-sample">
          <RecordingSnippet />
          <figcaption>{sample.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ======================================================= comparison -->
  <section class="compare" id="comparison">
    <div class="container">
      <h2>{home.compare.heading}</h2>
      <p class="section-sub">
        {home.compare.sub}
      </p>

      <div class="compare-scroll" tabindex="0" role="region" aria-label={home.compare.tableCaption}>
        <table class="compare-table">
          <caption class="vh">
            {home.compare.tableCaption}
          </caption>
          <thead>
            <tr>
              <th scope="col"><span class="vh">{home.compare.featureLabel}</span></th>
              {
                compareRows.map((row) => (
                  <th scope="col" class={row.self ? 'is-self' : undefined}>
                    {row.tool}
                    {row.note && <span class="row-note">{row.note}</span>}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              home.compare.features.map((col, i) => (
                <tr>
                  <th scope="row">{col}</th>
                  {compareRows.map((row) => {
                    const c = row.cells[i];
                    return (
                      <td class={row.self ? 'is-self' : undefined}>
                        <span class={`mark mark-${c}`} aria-hidden="true">
                          {markGlyph[c]}
                        </span>
                        <span class="vh">{markText[c]}</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="compare-foot">
        <span class="mark mark-p" aria-hidden="true">~</span> {home.compare.footStart}{' '}
        <a href={`${docsBase}reference/comparison/`}>{home.compare.footLinkLabel}</a>{home.compare.footEnd}
      </p>

      <p class="compare-tradeoff">{home.compare.tradeoff}</p>
    </div>
  </section>

  <!-- ======================================================= real auth -->
  <section class="auth" id="auth">
    <div class="container">
      <h2>{home.auth.heading}</h2>
      <p class="section-sub">
        {home.auth.sub}
      </p>
      <div class="auth-code">
        <AuthSetupSnippet />
      </div>
      <p class="auth-links">
        <a href={`${repo}/tree/master/apps/example-auth-cognito`}>{home.auth.links.cognito}</a>{' '}
        <a href={`${repo}/tree/master/apps/example-tanstack-start`}>{home.auth.links.tanstack}</a>{' '}
        <a href={`${repo}/tree/master/apps/example-auth-mock`}>{home.auth.links.mock}</a>
      </p>
    </div>
  </section>

  <!-- ====================================================== quick start -->
  <section class="quick-start" id="quick-start">
    <div class="container">
      <h2>{home.quickStart.heading}</h2>
      <p class="section-sub">
        {home.quickStart.subStart} <code>init</code>{' '}
        {home.quickStart.subEnd}
      </p>

      {/* Labelled, because three bullets under "Quick start" read as the steps. */}
      <h3 class="qs-changes-label">{home.quickStart.changes.label}</h3>
      <ul class="qs-changes">
        <li>{home.quickStart.changes.tests}</li>
        <li>
          {home.quickStart.changes.appStart} <code>registerProxyFetch()</code>{' '}
          {home.quickStart.changes.appEnd}
        </li>
        <li>{home.quickStart.changes.agent}</li>
        <li>{home.quickStart.changes.deployed}</li>
      </ul>

      {/* Two ways in, one shown at a time: with both open, "three steps" read as
          ten (2026-10-03 critique). The agent path opens first because most
          developers have a coding agent now (Alex). Without JavaScript both panels show. */}
      <div class="setup-tabs" data-tabs>
        <div class="tab-list" role="tablist" aria-label={home.quickStart.heading}>
          <button type="button" role="tab" id="tab-agent" aria-controls="panel-agent" aria-selected="true">
            {home.quickStart.tabs.agent}
          </button>
          <button type="button" role="tab" id="tab-manual" aria-controls="panel-manual" aria-selected="false" tabindex="-1">
            {home.quickStart.tabs.manual}
          </button>
        </div>

        <div class="tab-panel ai-setup" role="tabpanel" id="panel-agent" aria-labelledby="tab-agent">
          <p class="step-note">
            {home.quickStart.ai.noteStart} <code>init</code>{' '}
            {home.quickStart.ai.noteEnd}
          </p>
          {/* A labelled button, because Expressive Code's icon shows only on hover
              on desktop; the icon is hidden on this block so the prompt has one copy control. */}
          <p class="ai-copy">
            <CopyButton text={aiPrompt} label={home.quickStart.ai.copyLabel} copiedLabel={home.chrome.copied} />
          </p>
          <AiPromptSnippet />
        </div>

        <div class="tab-panel" role="tabpanel" id="panel-manual" aria-labelledby="tab-manual" hidden>
          <ol class="steps">
            <li class="step">
              <h3>{home.quickStart.steps.install.title}</h3>
              <p class="step-note">
                <code>init</code> {home.quickStart.steps.install.noteStart}{' '}
                <code>package.json</code> {home.quickStart.steps.install.noteEnd}
              </p>
              <InstallSnippet />
            </li>
            <li class="step">
              <h3>{home.quickStart.steps.apiEnv.title}</h3>
              <p class="step-note">
                {home.quickStart.steps.apiEnv.noteStart} <code>init</code>{' '}
                {home.quickStart.steps.apiEnv.noteEnd}
              </p>
              <ApiEnvSnippet />
              <p class="step-note">
                {home.quickStart.steps.apiEnv.ssrStart} <code>init</code>{' '}
                {home.quickStart.steps.apiEnv.ssrAfterInit} <code>registerProxyFetch()</code>{' '}
                {home.quickStart.steps.apiEnv.ssrAfterFn} <code>fetch</code>{' '}
                {home.quickStart.steps.apiEnv.ssrEnd}
              </p>
              <p class="step-note">{home.quickStart.steps.apiEnv.browserOnly}</p>
            </li>
            <li class="step">
              <h3>{home.quickStart.steps.record.title}</h3>
              <p class="step-note">
                {home.quickStart.steps.record.noteStart} <code>MODE = 'record'</code>{
                  home.quickStart.steps.record.noteMid
                } <code>'replay'</code>{' '}
                {home.quickStart.steps.record.noteEnd}
              </p>
              <FixtureSnippet />
            </li>
          </ol>
        </div>
      </div>
      <noscript><style>.tab-panel[hidden] { display: block; }</style></noscript>

      <p class="qs-guide">
        <a href={`${docsBase}getting-started/quick-start/`}>{home.quickStart.guideLink}</a>
      </p>
    </div>
  </section>

  <!-- ======================================================= questions -->
  <section class="band questions" id="questions">
    <div class="container">
      <h2>{questions.heading}</h2>
      <dl class="facts">
        <div>
          <dt>{questions.matching.term}</dt>
          <dd>
            {questions.matching.body}{' '}
            <a href={`${docsBase}getting-started/how-it-works/#replay-matching`}>{questions.matching.link}</a>
          </dd>
        </div>
        <div>
          <dt>{questions.misses.term}</dt>
          <dd>
            {questions.misses.start} <code>url</code> {questions.misses.mid} <code>before()</code>{' '}
            {questions.misses.end}
          </dd>
        </div>
        <div>
          <dt>{questions.liveApi.term}</dt>
          <dd>
            {questions.liveApi.start} <code>teardown()</code>{questions.liveApi.end}{' '}
            <a href={`${docsBase}reference/faq/#parallel-replay`}>{questions.liveApi.link}</a>
          </dd>
        </div>
        <div>
          <dt>{questions.drift.term}</dt>
          <dd>{questions.drift.body}</dd>
        </div>
        <div>
          <dt>{questions.overrides.term}</dt>
          <dd>
            {questions.overrides.start} <code>page.route()</code> {questions.overrides.mid}{' '}
            <code>before()</code> {questions.overrides.end}{' '}
            <a href={`${docsBase}reference/faq/#override-responses`}>{questions.overrides.link}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============================================================== cta -->
  <section class="cta">
    <div class="container cta-inner">
      <h2>{home.cta.heading}</h2>
      <p class="cta-sub">
        {home.cta.sub}
      </p>
      <div class="cta-actions">
        <span class="cmd cmd-on-dark">
          <code>{installCmd}</code>
          <CopyButton text={installCmd} label={home.cta.copyLabel} copiedLabel={home.chrome.copied} />
        </span>
        <a class="btn btn-on-dark btn-star" href={`${repo}/stargazers`}>
          <span class="star-glyph" aria-hidden="true">★</span> {home.cta.starCta}
        </a>
      </div>
      <p class="cta-fine">
        {home.cta.fineStart} <a href={`${repo}/issues/new`}>{home.cta.issueLabel}</a>{' '}
        {home.cta.fineBetween}{' '}
        <a href="https://discord.gg/w7rgYbY5zz">{home.cta.discordLabel}</a>{home.cta.fineEnd}
      </p>
    </div>
  </section>
</Layout>

<script>
  // Tabs per the ARIA pattern: click or arrow keys switch, Tab moves into the panel.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (next: HTMLButtonElement) => {
      for (const tab of tabs) {
        const isSelected = tab === next;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !isSelected;
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = ({ ArrowRight: 1, ArrowLeft: -1 } as Record<string, number>)[event.key];
        if (!step) return;
        const next = tabs[(index + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });

  // Plays only for readers who have not asked for less motion (PRODUCT.md), and
  // only once half of it is on screen: it is 2.9 MB, and it used to buffer in
  // full while the page sat at the top. The rest get the poster and the controls.
  const demo = document.querySelector<HTMLVideoElement>('video.demo-video');
  if (demo && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    new IntersectionObserver(
      ([entry]) => {
        // A refused play() leaves the poster up, which is the reduced-motion state anyway.
        if (entry.isIntersecting) demo.play().catch(() => undefined);
        else demo.pause();
      },
      { threshold: 0.5 },
    ).observe(demo);
  }
</script>

<style>
  section {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }

  .section-sub {
    color: var(--muted);
    margin-top: 0.7rem;
    max-width: 56ch;
  }

  .section-sub a {
    color: var(--link);
  }

  /* visually hidden — accessible text equivalents for the table marks */
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* --------------------------------------------------------- comparison */

  .compare-scroll {
    /* The containing block for the cells' visually hidden labels: they are
       absolutely positioned, and against the page they escaped this scroller
       and widened a 390px phone to 707px. */
    position: relative;
    margin-top: 2rem;
    overflow-x: auto;
    /* Scroll shadows: a shade at an edge with more columns beyond it, covered
       by the page colour once scrolled to that edge. On a phone four of the six
       tools sat off-screen with no hint (2026-10-03 critique). */
    background:
      linear-gradient(to left, var(--bg) 40%, transparent) right / 2.5rem 100% no-repeat local,
      radial-gradient(farthest-side at 100% 50%, oklch(0 0 0 / 0.2), transparent) right / 0.9rem 100% no-repeat scroll;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 720px;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .compare-table thead th {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    vertical-align: bottom;
    line-height: 1.25;
  }

  .compare-table thead th:first-child,
  .compare-table tbody th {
    text-align: left;
  }

  .compare-table tbody th {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .row-note {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  /* highlight the test-proxy-recorder column */
  .compare-table th.is-self,
  .compare-table td.is-self {
    background: var(--primary-soft);
  }

  .compare-table thead th.is-self {
    color: var(--primary-on-soft);
    box-shadow: inset 0 3px 0 var(--primary);
  }

  .mark {
    font-size: 1.05rem;
    line-height: 1;
  }

  /* `--primary` is a fill: this glyph measured 2.92:1. ✓ in `--link`, ~ in
     `--ink`, ✕ in `--muted`: each has a checked floor, and the steps run from
     most to least support. ~ was `--accent-on-soft`, whose red-orange read as
     worse than ✕ (2026-10-03 critique). */
  .mark-y {
    color: var(--link);
    font-weight: 700;
  }

  /* `--muted` has a checked floor; `--muted/55` has none. */
  .mark-n {
    color: var(--muted);
  }

  .mark-p {
    color: var(--ink);
    font-weight: 700;
  }

  .compare-foot {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 62ch;
  }

  /* On a phone the table scrolls; the row labels stay put so each mark keeps its meaning. */
  .compare-table tbody th,
  .compare-table thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--bg);
  }

  .compare-foot .mark-p {
    font-size: 0.85rem;
  }

  .compare-foot a {
    color: var(--link);
  }

  /* ---------------------------------------------------------- real auth */

  .auth-code {
    max-width: 640px;
    margin-top: 1.6rem;
  }

  /* The global 62ch measure wrapped this row 2 + 1 at 1440. */
  .auth-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
