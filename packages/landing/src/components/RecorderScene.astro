---
interface Props {
  pauseLabel: string;
  playLabel: string;
}

const { pauseLabel, playLabel } = Astro.props;
---

<figure class="scene" aria-label="Diagram: in record mode requests flow from your app's server through the proxy to the real API and are saved to disk; in replay mode the proxy serves the saved responses from disk without calling the API.">
  <div class="scene-bar" aria-hidden="true">
    <span class="bar-dot"></span>
    <span class="bar-dot"></span>
    <span class="bar-dot"></span>
    <span class="bar-title">npx playwright test</span>
  </div>
  {/* WCAG 2.2.2: the loop runs longer than five seconds beside other content. */}
  <button
    class="scene-toggle"
    type="button"
    data-pause-label={pauseLabel}
    data-play-label={playLabel}>{pauseLabel}</button
  >

  <div class="phase">
    <p class="phase-head rec-head">
      <span class="lamp" aria-hidden="true"></span>
      REC <span class="phase-meta">· MODE=record · local run</span>
    </p>
    <div class="track" aria-hidden="true">
      <span class="node">app server</span>
      <span class="wire">
        <span class="lane lane-1"><i class="packet packet-app"></i></span>
        <span class="lane lane-7"><i class="packet packet-play"></i></span>
      </span>
      <span class="node node-proxy">proxy</span>
      <span class="wire">
        <span class="lane lane-2"><i class="packet packet-rec"></i></span>
        <span class="lane lane-6"><i class="packet packet-rec"></i></span>
      </span>
      <span class="node">real API</span>
    </div>
    <p class="result">
      <span class="glyph-rec" aria-hidden="true">⤓</span>
      saved&ensp;<span class="result-file">todos__adds-a-todo.mock.json</span>
    </p>
  </div>

  <div class="phase-divider" aria-hidden="true"></div>

  <div class="phase">
    <p class="phase-head play-head">
      <span class="play-glyph" aria-hidden="true">▶</span>
      REPLAY <span class="phase-meta">· MODE=replay · CI</span>
    </p>
    <div class="track" aria-hidden="true">
      <span class="node">app server</span>
      <span class="wire">
        <span class="lane lane-3"><i class="packet packet-play"></i></span>
        <span class="lane lane-5"><i class="packet packet-ok"></i></span>
      </span>
      <span class="node node-proxy">proxy</span>
      <span class="wire"><span class="lane lane-4"><i class="packet packet-ok"></i></span></span>
      <span class="node">disk</span>
    </div>
    <p class="result">
      <span class="glyph-play" aria-hidden="true">✓</span>
      200 OK · 3 ms · <span class="result-strong">from disk</span>
    </p>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.scene-toggle').forEach((button) => {
    // The label names the action, so no aria-pressed: with both, a screen
    // reader announced "Play, toggle button, pressed" (2026-10-03 critique).
    button.addEventListener('click', () => {
      const scene = button.closest('.scene');
      const paused = !scene?.hasAttribute('data-paused');
      scene?.toggleAttribute('data-paused', paused);
      button.textContent = (paused ? button.dataset.playLabel : button.dataset.pauseLabel) ?? '';
    });
  });
</script>

<style>
  .scene-toggle {
    position: absolute;
    top: 0.62rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--panel-muted);
    background: transparent;
    border: 1px solid var(--panel-edge);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
    cursor: pointer;
  }

  .scene-toggle:hover {
    color: var(--panel-ink);
  }

  .scene[data-paused] .packet {
    animation-play-state: paused;
  }

  .scene {
    position: relative;
    /* The packets travel past the wire ends mid-animation; unclipped, they
       widened the page to 875px at 768. */
    overflow: clip;
    container-type: inline-size;
    --cycle: 6s;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 14px;
    box-shadow: var(--shadow-panel);
    padding: 0 1.4rem 1.45rem;
    font-family: var(--font-mono);
    color: var(--panel-ink);
  }

  .scene-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--panel-edge);
    margin-bottom: 1.3rem;
  }

  .bar-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--panel-edge);
  }

  .bar-title {
    margin-left: 0.65rem;
    font-size: 0.72rem;
    color: var(--panel-muted);
    letter-spacing: 0.01em;
  }

  .phase-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .rec-head {
    color: var(--panel-rec-text);
  }

  .play-head {
    color: var(--panel-accent);
  }

  .phase-meta {
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--panel-muted);
  }

  .lamp {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    /* Steady and unlit: PRODUCT.md rules out the glow hero, and a pulsing dot
       was the Impeccable detector's one error (2026-10-03). */
    background: var(--panel-rec);
  }

  .play-glyph {
    font-size: 0.65rem;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-block: 0.95rem 0.8rem;
  }

  .node {
    flex-shrink: 0;
    min-width: 0;
    font-size: 0.74rem;
    padding: 0.32rem 0.62rem;
    border: 1px solid var(--panel-edge);
    border-radius: 7px;
    background: oklch(0.262 0.042 262);
    color: var(--panel-ink);
    white-space: nowrap;
  }

  .node-proxy {
    border-color: var(--panel-accent);
    color: oklch(0.88 0.06 262);
  }

  .wire {
    position: relative;
    flex: 1;
    min-width: 1.5rem;
    height: 2px;
    background: var(--panel-edge);
    border-radius: 1px;
  }

  .lane {
    position: absolute;
    inset: 0;
  }

  .packet {
    position: absolute;
    top: 50%;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
  }

  .packet-rec {
    background: var(--panel-rec);
  }

  .packet-app {
    background: oklch(0.95 0.008 262);
  }

  .packet-play {
    background: oklch(0.78 0.12 262);
  }

  .packet-ok {
    background: oklch(0.8 0.13 150);
  }

  .lane-1 {
    animation: travel-a var(--cycle) linear infinite;
  }

  .lane-2 {
    animation: travel-b var(--cycle) linear infinite;
  }

  .lane-6 {
    animation: travel-f var(--cycle) linear infinite;
  }

  .lane-7 {
    animation: travel-g var(--cycle) linear infinite;
  }

  .lane-3 {
    animation: travel-c var(--cycle) linear infinite;
  }

  .lane-4 {
    animation: travel-d var(--cycle) linear infinite;
  }

  .lane-5 {
    animation: travel-e var(--cycle) linear infinite;
  }

  .lane-1 .packet {
    animation: blink-1 var(--cycle) linear infinite;
  }

  .lane-2 .packet {
    animation: blink-2 var(--cycle) linear infinite;
  }

  .lane-6 .packet {
    animation: blink-6 var(--cycle) linear infinite;
  }

  .lane-7 .packet {
    animation: blink-7 var(--cycle) linear infinite;
  }

  .lane-3 .packet {
    animation: blink-3 var(--cycle) linear infinite;
  }

  .lane-4 .packet {
    animation: blink-4 var(--cycle) linear infinite;
  }

  .lane-5 .packet {
    animation: blink-5 var(--cycle) linear infinite;
  }

  .result {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    /* The replay line is the page's promise; at 11.8px it read as fine print. */
    font-size: 0.8125rem;
    color: var(--panel-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .result-file {
    color: var(--panel-ink);
  }

  .result-strong {
    color: oklch(0.85 0.09 150);
  }

  .glyph-rec {
    color: var(--panel-rec-text);
  }

  .glyph-play {
    color: oklch(0.85 0.09 150);
  }

  .phase-divider {
    height: 1px;
    background: var(--panel-edge);
    margin-block: 1.25rem;
  }

  /* One 6s cycle, timed so the hops differ in kind: app↔proxy is a local
     350ms hop in both halves, proxy↔API a 550ms network hop with a 300ms wait
     at the API, and replay's disk hop 120ms, so REPLAY finishes in about a
     third of REC's time. With every hop near 900ms the motion contradicted
     "3 ms · from disk" (2026-10-03 critique). 1% = 60ms. */
  @keyframes travel-a {
    0%, 5% { transform: translateX(0); }
    10.83%, 100% { transform: translateX(100%); }
  }

  @keyframes travel-b {
    0%, 12.5% { transform: translateX(0); }
    21.67%, 100% { transform: translateX(100%); }
  }

  @keyframes travel-f {
    0%, 26.67% { transform: translateX(100%); }
    35.83%, 100% { transform: translateX(0); }
  }

  @keyframes travel-g {
    0%, 37.5% { transform: translateX(100%); }
    43.33%, 100% { transform: translateX(0); }
  }

  /* Replay: request app→proxy (travel-c), the response from disk→proxy
     (travel-d), handed back proxy→app (travel-e). */
  @keyframes travel-c {
    0%, 60% { transform: translateX(0); }
    65.83%, 100% { transform: translateX(100%); }
  }

  @keyframes travel-d {
    0%, 67.5% { transform: translateX(100%); }
    69.5%, 100% { transform: translateX(0); }
  }

  @keyframes travel-e {
    0%, 71.17% { transform: translateX(100%); }
    77%, 100% { transform: translateX(0); }
  }

  /* Each packet fades in over the 60ms before its hop and out over the 60ms
     after; the disk packet's fades are shorter so its neighbours never overlap it. */
  @keyframes blink-1 {
    0%, 4% { opacity: 0; }
    5%, 10.83% { opacity: 1; }
    11.83%, 100% { opacity: 0; }
  }

  @keyframes blink-2 {
    0%, 11.5% { opacity: 0; }
    12.5%, 21.67% { opacity: 1; }
    22.67%, 100% { opacity: 0; }
  }

  @keyframes blink-6 {
    0%, 25.67% { opacity: 0; }
    26.67%, 35.83% { opacity: 1; }
    36.83%, 100% { opacity: 0; }
  }

  @keyframes blink-7 {
    0%, 36.5% { opacity: 0; }
    37.5%, 43.33% { opacity: 1; }
    44.33%, 100% { opacity: 0; }
  }

  @keyframes blink-3 {
    0%, 59% { opacity: 0; }
    60%, 65.83% { opacity: 1; }
    66.83%, 100% { opacity: 0; }
  }

  @keyframes blink-4 {
    0%, 66.83% { opacity: 0; }
    67.5%, 69.5% { opacity: 1; }
    70.17%, 100% { opacity: 0; }
  }

  @keyframes blink-5 {
    0%, 70.17% { opacity: 0; }
    71.17%, 77% { opacity: 1; }
    78%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .packet {
      opacity: 0;
    }

    /* Nothing moves, so there is nothing to pause. */
    .scene-toggle {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .scene {
      padding-inline: 1rem;
    }

    .node {
      font-size: 0.68rem;
      padding: 0.28rem 0.45rem;
    }

    .result {
      font-size: 0.75rem;
    }
  }

  /* Below about 384px of viewport the 0.68rem row cut "proxy" to "pro…"
     (2026-10-03 critique); smaller nodes and wires keep every label whole
     down to 320px. */
  @container (max-width: 20rem) {
    .track {
      gap: 0.4rem;
    }

    .node {
      font-size: 0.6rem;
      padding: 0.26rem 0.38rem;
    }

    .wire {
      min-width: 0.75rem;
    }
  }

  /* WCAG reflow at 320px: an unshrinkable row of nodes made the page 359px
     wide. A last resort; the container query above keeps labels whole. */
  @media (max-width: 320px) {
    .node {
      flex-shrink: 1;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
