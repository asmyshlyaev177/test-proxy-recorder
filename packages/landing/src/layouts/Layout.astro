---
import schibstedUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import splineItalicUrl from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-italic.woff2?url';
import splineUrl from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import LanguagePicker from '../components/LanguagePicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
// Read from the package being documented so `softwareVersion` in the JSON-LD
// can't drift from what npm actually serves.
import { version as pkgVersion } from '../../../test-proxy-recorder/package.json';
import {
  alternates,
  dateLocale,
  localePrefix,
  ogLocale,
  SOURCE,
  stripLocale,
  type Locale,
} from '../i18n';
import { home as englishCopy } from '../i18n/home/en';
import type { HomeCopy } from '../i18n/home/types';

interface Props {
  /** Defaults to English so a page that isn't localised needs no change. */
  locale?: Locale;
  copy?: HomeCopy;
}

const locale = Astro.props.locale ?? SOURCE;
const copy = Astro.props.copy ?? englishCopy;

/** `''` for English, `/ja` for the rest — every in-site link is built from it. */
const prefix = localePrefix(locale.code);

const repo = 'https://github.com/asmyshlyaev177/test-proxy-recorder';
const npmUrl = 'https://www.npmjs.com/package/test-proxy-recorder';
const discordUrl = 'https://discord.gg/w7rgYbY5zz';
const authorUrl = 'https://asmyshlyaev177.dev';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = copy.meta.title;
const description = copy.meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('og.png', Astro.site);

// When the content last changed (HEAD commit) — see scripts/build-date.mjs.
// Drives `dateModified` in the JSON-LD and the "Updated" line in the footer.
const lastModified = new Date(__CONTENT_LAST_MODIFIED__);
// Formatted in the page's own language: "13 August 2026" reads as an error on
// a Japanese page. Intl carries every locale here in Node and in workerd, so
// this needs no data of our own.
const lastModifiedLabel = lastModified.toLocaleDateString(dateLocale(locale.code), {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const copyrightYear = lastModified.getUTCFullYear();

// Latin-only @font-face, declared here so the hashed font URLs can be
// preloaded. font-display: optional + preload = no visible font swap:
// the font wins the race on normal loads; on very slow cold loads the
// fallback simply stays for the session instead of swapping mid-read.
const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaceCss = `
@font-face{font-family:'Schibsted Grotesk Variable';font-style:normal;font-display:optional;font-weight:400 900;src:url(${schibstedUrl}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'Spline Sans Mono Variable';font-style:normal;font-display:optional;font-weight:300 700;src:url(${splineUrl}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'Spline Sans Mono Variable';font-style:italic;font-display:swap;font-weight:300 700;src:url(${splineItalicUrl}) format('woff2-variations');unicode-range:${latinRange}}
`;

// The WebSite node carries the site name, so the <title> can spend its ~60
// characters on what the tool does instead of on the brand.
const webSite = {
  '@type': 'WebSite',
  name: 'test-proxy-recorder',
  url: new URL('/', Astro.site).href,
};

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'test-proxy-recorder',
  description,
  url: canonical.href,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Testing tool',
  operatingSystem: 'Node.js >= 20',
  softwareVersion: pkgVersion,
  dateModified: lastModified.toISOString().slice(0, 10),
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: `${repo}/blob/master/LICENSE`,
  softwareHelp: `${new URL('docs/', Astro.site).href}`,
  releaseNotes: `${repo}/releases`,
  discussionUrl: `${repo}/issues`,
  downloadUrl: npmUrl,
  installUrl: npmUrl,
  sameAs: [repo, npmUrl],
  keywords:
    'vcr for playwright, playwright, e2e testing, api mocking, record replay, HAR, deterministic tests, test proxy, http recording proxy, mock server, network stubbing, api fixtures, flaky tests, ssr mocking, server-side mocking, nextjs, websocket',
  author: {
    '@type': 'Person',
    name: 'asmyshlyaev177',
    url: authorUrl,
  },
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [webSite, softwareApplication] };
---

<!doctype html>
<html lang={locale.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      import.meta.env.PROD && (
        <Fragment>
          {/* Google tag (gtag.js) — production builds only. Fetched at idle
              rather than as an early <script async>: as a plain async tag it
              went out ahead of the render-blocking CSS, and it blocks nothing
              that matters. The queued calls replay when it lands. */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());

            gtag('config', 'G-9EV956L4B6');

            addEventListener('load', function () {
              var load = function () {
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-9EV956L4B6';
                document.head.appendChild(s);
              };
              'requestIdleCallback' in window
                ? requestIdleCallback(load, { timeout: 4000 })
                : setTimeout(load, 2000);
            });
          </script>
        </Fragment>
      )
    }
    <link rel="preload" as="font" type="font/woff2" href={schibstedUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={splineUrl} crossorigin />
    <style set:html={fontFaceCss}></style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="asmyshlyaev177" />
    <meta name="directree-verify" content="directree-verify=8c75fb7b9cfcad2c2f70be353d80c6ba" />
    <link rel="canonical" href={canonical.href} />
    {/* Each indexed language of this page lists every other one *and itself*,
        plus an x-default pointing at English. A cluster whose members disagree
        about who is in it is discarded wholesale, so this is generated from
        one list rather than written per page. An unindexed locale says
        `noindex` instead. Starlight's docs get the same treatment from
        src/starlightRouteData.ts; this covers the hand-built marketing page. */}
    {
      locale.indexed ? (
        alternates(stripLocale(Astro.url.pathname), Astro.site).map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="last-modified" content={lastModified.toISOString()} />
    <link
      rel="alternate"
      type="text/markdown"
      title="LLM-friendly reference (llms.txt)"
      href="/llms.txt"
    />
    <link
      rel="alternate"
      type="text/markdown"
      title="Full documentation as Markdown (llms-full.txt)"
      href="/llms-full.txt"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="test-proxy-recorder" />
    <meta property="og:locale" content={ogLocale(locale.code)} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101011" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme =
        stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.chrome.skipToContent}</a>

    <header class="site-header">
      <div class="container header-row">
        <a class="wordmark" href={`${base}${prefix}/`}>
          <span class="wordmark-dot" aria-hidden="true"></span>
          test-proxy-recorder
        </a>
        <nav aria-label="Site">
          <a class="nav-extra" href="#quick-start">{copy.chrome.navQuickStart}</a>
          <a href={`${base}${prefix}/docs/`}>{copy.chrome.navDocs}</a>
          <a class="nav-extra" href={npmUrl}>npm</a>
          <a href={repo}>GitHub</a>
          <a class="nav-extra" href={discordUrl}>Discord</a>
          <span class="header-lang">
            <LanguagePicker locale={locale} label={copy.chrome.languageLabel} variant="menu" />
          </span>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <p>
          © {copyrightYear} <a href="https://asmyshlyaev177.dev">asmyshlyaev177</a>. {
            copy.chrome.licensed
          } {copy.chrome.updated} <time datetime={lastModified.toISOString()}>{lastModifiedLabel}</time
          >.
        </p>
        {/* The header drops these on a phone, so the footer is where they stay reachable. */}
        <nav class="footer-nav" aria-label="Footer">
          <a href={`${base}${prefix}/docs/`}>{copy.chrome.navDocs}</a>
          <a href={repo}>GitHub</a>
          <a href={npmUrl}>npm</a>
          <a href={discordUrl}>Discord</a>
          <a href="/llms.txt">llms.txt</a>
          <span class="footer-lang">
            <LanguagePicker locale={locale} label={copy.chrome.languageLabel} variant="list" />
          </span>
        </nav>
        <a
          class="open-launch-badge"
          href="https://open-launch.com/projects/test-proxy-recorder"
          target="_blank"
          rel="noopener"
        >
          <img
            class="badge-light"
            src="https://open-launch.com/api/badge/0b7dbb08-7e6b-48c9-b705-961b2aeb0436/featured-light.svg"
            alt="Featured on Open-Launch"
            width="200"
            height="50"
            loading="lazy"
          />
          <img
            class="badge-dark"
            src="https://open-launch.com/api/badge/0b7dbb08-7e6b-48c9-b705-961b2aeb0436/featured-dark.svg"
            alt="Featured on Open-Launch"
            width="200"
            height="50"
            loading="lazy"
          />
        </a>
        <p class="footer-meta">Node ≥ 20 · @playwright/test ≥ 1.0</p>
      </div>
    </footer>

    {/* Shared across my sites — one implementation, served from the portfolio.
        It shows itself only while the GitHub "Available for hire" toggle is on,
        reads <html data-theme> for its palette, and renders nothing otherwise.
        Loaded async so it stays off the critical path. */}
    <for-hire-badge></for-hire-badge>
    <script is:inline async src="https://asmyshlyaev177.dev/for-hire-badge.js"
    ></script>

    {/* Announces a successful copy; the button's own text change is not read out. */}
    <p id="copy-status" class="copy-status" role="status"></p>

    <script>
      // The copy buttons (CopyButton.astro); the code blocks use Expressive Code's own.
      const copyStatus = document.getElementById('copy-status');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          } catch {
            // Denied clipboard: claim nothing; the command stays selectable on screen.
            return;
          }
          btn.classList.add('copied');
          if (copyStatus) copyStatus.textContent = btn.querySelector('.copy-done')?.textContent ?? '';
          setTimeout(() => {
            btn.classList.remove('copied');
            if (copyStatus) copyStatus.textContent = '';
          }, 1600);
        });
      });
    </script>

    <style>
      .copy-status {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        /* At 88% a dark code panel scrolling underneath showed through the nav
           as a grey smear (2026-10-03 VisAWI). */
        background: color-mix(in oklch, var(--bg) 96%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }

      .header-row {
        display: flex;
        /* At 320px the nav drops under the wordmark instead of widening the page. */
        flex-wrap: wrap;
        row-gap: 0.4rem;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.75rem;
      }

      .wordmark {
        display: inline-flex;
        white-space: nowrap;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--ink);
        text-decoration: none;
        letter-spacing: -0.01em;
      }

      .wordmark-dot {
        flex-shrink: 0;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--panel-rec);
        box-shadow: 0 0 0 3px var(--panel-rec-soft);
      }

      .site-header nav {
        display: flex;
        align-items: center;
        gap: clamp(0.75rem, 2.5vw, 1.5rem);
      }

      .site-header nav a {
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
      }

      .site-header nav a:hover {
        color: var(--link);
      }

      .site-footer {
        border-top: 1px solid var(--line);
        padding-block: 2rem;
      }

      .footer-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem;
        font-size: var(--step--1);
        color: var(--muted);
      }

      .footer-row a {
        color: inherit;
      }

      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 1.1rem;
      }

      .footer-lang {
        display: none;
      }

      .footer-meta {
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .open-launch-badge {
        display: inline-flex;
        line-height: 0;
      }

      .open-launch-badge img {
        height: 50px;
        width: auto;
      }

      /* Show the badge variant that matches the active theme. */
      .badge-dark {
        display: none;
      }

      :global([data-theme='dark']) .badge-light {
        display: none;
      }

      :global([data-theme='dark']) .badge-dark {
        display: inline-block;
      }

      /* Below 800px the full nav overflowed (641-699px) or wrapped "Quick start";
         the header keeps the wordmark, Docs, GitHub and the theme toggle, and the
         rest, the language menu included, is in the footer. */
      @media (max-width: 800px) {
        .nav-extra,
        .header-lang {
          display: none;
        }

        .footer-lang {
          display: inline-flex;
        }
      }
    </style>
  </body>
</html>
