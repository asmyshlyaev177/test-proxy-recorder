---
import HomePage from '../components/HomePage.astro';
import { home } from '../i18n/home/en';
import { SOURCE } from '../i18n';

// Rendered on-demand (not prerendered) so src/middleware.ts can intercept the
// request and serve the Markdown reference to AI agents that send
// `Accept: text/markdown`. On Cloudflare, prerendered routes are served as
// static assets and bypass the Worker/middleware entirely, so `/` must be a
// Worker route for the content negotiation to run. The code snippets still
// highlight at build time (they are compiled Markdown partials, not a
// render-time highlighter), so nothing changes about how they render.
//
// The translated homepages are the opposite — see src/pages/[locale]/index.astro.
export const prerender = false;

// Edge/browser caching for the HTML response; `Vary: Accept` keeps it distinct
// from the Markdown variant middleware serves for the same URL.
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
Astro.response.headers.set('Vary', 'Accept');
---

<HomePage copy={home} locale={SOURCE} />
